---
import CopyButton from "../components/CopyButton.astro";
import CopyInstruction from "../components/CopyInstruction.astro";
import AnnotationIcon from "../components/AnnotationIcon.astro";
import AnimatedWordmark from "../components/AnimatedWordmark.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import schema from "../../schema/versions.json";
import decisionExample from "../../examples/DECISIONS.md?raw";
import { skillSources } from "../lib/skill-sources";

const steps = [
  {
    title: "Find the rule and its consumers",
    description: "For a feature or fix, the agent searches DECISIONS.md by product name, surface or ID. Related decisions and actual callers show which other lists, sites or customers could be affected."
  },
  {
    title: "Reuse what fits",
    description: "A partner site that needs a compact card can use the existing card’s size option. The agent asks only if the choice changes a product promise or another consumer’s behavior."
  },
  {
    title: "Verify the change and record the decision",
    description: "The agent follows the project’s testing discipline, including TDD where configured, and checks affected consumers. A new promise updates the owning record. A fix that restores an existing rule can cite its ID."
  }
];

const conversationExamples = [
  ["“Partner lists use the same item card.”", "The agent adds the partner list to the existing card decision in DECISIONS.md. The record keeps its ID, its reason and the sizes each list can use."],
  ["“When a card changes, check both sizes.”", "This is a recurring instruction for the team. The agent adds it once to Project practice in SKILL.md and uses it the next time a card changes."],
  ["“Could we try an extra-small card?”", "The agent can explore the idea. The suggestion stays in the conversation until someone settles the product rule."]
];

const activationTriggers = [
  "A feature or fix that affects product behavior",
  "A request that may conflict with a recorded rule, or extend one",
  "Anything new that an existing component, flow, or rule might already cover",
  "A question about why the product works the way it does",
  "A discussion that settles a product promise or corrects a recurring way of working"
];

const projectTree = `AGENTS.md                         # routes project work to the skill
CLAUDE.md                         # imports AGENTS.md
.agents/skills/spec-library/
  SKILL.md                        # workflow, TDD and project practice
  DECISIONS.md                    # created with the first decision
.claude/skills/spec-library       # links to the same skill`;
---

<BaseLayout
  title="What is Simplest SDD?"
  description="Why Simplest SDD exists, how its library of business decisions works, and when it helps."
  canonicalPath="/about/"
  bodyClass="about-body"
>
  <SiteHeader current="about" />

  <main>
    <section class="about-hero" aria-labelledby="about-title">
      <h1 id="about-title">Why record <span class="title-highlight title-highlight--orange">product decisions</span>?</h1>
      <div class="about-hero__copy">
        <p class="hero-summary">
          Code shows how a feature works today. A short decision tells the next person or agent who relies on it
          and why. Simplest SDD saves those agreements in one Markdown file as you work.
        </p>
      </div>
    </section>

    <div class="about-layout">
      <aside class="about-map" aria-label="What is Simplest SDD sections">
        <ol>
          <li><a href="#why"><span>01</span>Why Simplest SDD?</a></li>
          <li><a href="#what-it-does"><span>02</span>What it does</a></li>
          <li><a href="#why-useful"><span>03</span>Learning from conversation</a></li>
          <li><a href="#when-it-activates"><span>04</span>When it activates</a></li>
          <li><a href="#use-it"><span>05</span>How to use it</a></li>
          <li><a href="#project-output"><span>06</span>What it adds</a></li>
          <li><a href="#inspiration"><span>07</span>Inspiration</a></li>
        </ol>
      </aside>

      <div class="about-sections">
    <section class="content-section why-section content-section--accent-1" id="why" aria-labelledby="why-title">
      <div class="section-heading">
        <p class="section-number">01</p>
        <div>
          <h2 id="why-title">Why Simplest SDD?</h2>
          <CopyButton sectionId="why" label="Copy link to Why Simplest SDD?" className="section-copy-button" />
        </div>
      </div>
      <div class="why-grid">
        <div class="prose prose--large">
          <p>
            A technical spec written last month may still describe a component that has since moved or been replaced.
            An agent can inspect the current implementation and its callers directly.
          </p>
          <p>
            The reason for a rule is harder to recover. A CSV writer tells an agent which columns it exports.
            A decision tells it that partner spreadsheets depend on those columns appearing in that order.
          </p>
        </div>
        <aside class="principle-card">
          <p>What would a maintainer need to know before changing the export?</p>
          <strong>Who relies on the column order, and what breaks if it changes.</strong>
        </aside>
      </div>
    </section>

    <section class="content-section content-section--accent-2" id="what-it-does" aria-labelledby="how-title">
      <div class="section-heading">
        <p class="section-number">02</p>
        <div>
          <h2 id="how-title">What it does</h2>
          <CopyButton sectionId="what-it-does" label="Copy link to What it does" className="section-copy-button" />
        </div>
        <span>From a feature request to a verified change.</span>
      </div>
      <ol class="step-grid">
        {steps.map((step, index) => (
          <li>
            <div class="step-heading">
              <span class="step-number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
            </div>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
      <div class="workflow-notes prose">
        <p>
          A decision starts with a stable ID, status and rule. Add the reason, affected surfaces and any sharing
          boundary another maintainer should know. A related ID links directly to another heading in the same file.
        </p>
      </div>
    </section>

    <section class="content-section content-section--accent-3" id="why-useful" aria-labelledby="useful-title">
      <div class="section-heading">
        <p class="section-number">03</p>
        <div>
          <h2 id="useful-title">What an ordinary conversation saves</h2>
          <CopyButton sectionId="why-useful" label="Copy link to Learning from conversation" className="section-copy-button" />
        </div>
      </div>
      <div class="benefit-grid">
        {conversationExamples.map(([title, description]) => (
          <article>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
      <div class="workflow-notes prose">
        <p>
          You can settle a rule while discussing a feature, even if implementation is weeks away. The agent tells
          you where it saved the agreement and distinguishes approved work from shipped behavior. Later corrections
          amend that record or the project’s local practice. Framework updates preserve both.
        </p>
      </div>
    </section>

    <section class="content-section activation-section content-section--accent-1" id="when-it-activates" aria-labelledby="activation-title">
      <div class="section-heading">
        <p class="section-number">04</p>
        <div>
          <h2 id="activation-title">When it activates</h2>
          <CopyButton sectionId="when-it-activates" label="Copy link to When it activates" className="section-copy-button" />
        </div>
      </div>
      <div class="activation-grid">
        <div>
          <p class="activation-intro">The agent opens the library when one of these comes up.</p>
          <ul>
            {activationTriggers.map((trigger) => <li>{trigger}</li>)}
          </ul>
        </div>
        <aside>
          <p>A clear, low-risk edit?</p>
          <strong>Just build it.</strong>
          <span>
            A fix that restores a recorded rule can proceed under that decision. Before adding a component,
            the agent checks whether an existing one already covers the change.
            You can also ask for more at any time. Say <em>grill me</em> for a full interview through every open
            decision, <em>why does it work this way?</em> for an answer from the record, or <em>review reuse</em>
            for a sweep of duplicated business rules.
          </span>
        </aside>
      </div>
    </section>

    <section class="content-section content-section--accent-2" id="use-it" aria-labelledby="use-title">
      <div class="section-heading">
        <p class="section-number">05</p>
        <div>
          <h2 id="use-title">How to use it</h2>
          <CopyButton sectionId="use-it" label="Copy link to How to use it" className="section-copy-button" />
        </div>
        <span>Copy one instruction and give it to your coding agent.</span>
      </div>
      <div class="instruction-grid">
        <CopyInstruction
          label="Install"
          action="init"
          description="Give the agent guidance on how to talk to your clients and team. Install the local skill with the project’s testing discipline."
        />
        <CopyInstruction
          label="Update"
          action="update"
          description="Fill gaps in communication guidance and keep your existing preferences. Consolidate older libraries into one decision file."
        />
        <CopyInstruction
          label="Remove"
          action="remove"
          description="Deactivate the framework while preserving your recorded decisions."
        />
      </div>
      <p class="update-note">
        The CLI prints instructions for your coding agent to apply. Schema {schema.currentSchemaVersion} reads old Markdown specs,
        HTML feature folders and the 0.19 decision map and area pages. It keeps business rules, stable IDs, links, history,
        testing commands and local practices, then removes the obsolete generated pages, references and empty directories.
      </p>
      <p class="update-note">
        The update also clears obsolete generated reports from earlier framework backups. Git retains clean, tracked
        originals. Uncommitted source documents and project guidance that need a recovery copy go under
        <code>.agents/archive/simplest-sdd/</code>. The agent reports what it removed.
      </p>
    </section>

    <section class="content-section content-section--accent-3" id="project-output" aria-labelledby="project-title">
      <div class="section-heading">
        <p class="section-number">06</p>
        <div>
          <h2 id="project-title">What it adds to a project</h2>
          <CopyButton sectionId="project-output" label="Copy link to What it adds to a project" className="section-copy-button" />
        </div>
      </div>
      <div class="artifact-grid">
        <div class="tree-panel">
          <div class="panel-bar">
            <span>decision library</span>
            <span>Markdown</span>
          </div>
          <pre><code>{projectTree}</code></pre>
        </div>
        <div class="artifact-copy prose">
          <p>
            <strong>SKILL.md</strong> holds the workflow and the team’s testing and project practices.
            <code>AGENTS.md</code> routes the agent to it and holds or links to the team’s communication guidance.
            Claude uses the same instructions through its compatibility link.
          </p>
          <p>
            <strong>DECISIONS.md</strong> appears with the first decision. New product areas get headings in the same
            file. Search by rule, surface or shared capability and follow the links between IDs. You can read and edit
            the original Markdown in a repository viewer or text editor.
          </p>
          <details class="decision-example">
            <summary>Read the decision file for the shared card example</summary>
            <pre><code>{decisionExample.trim()}</code></pre>
          </details>
        </div>
      </div>
    </section>

    <section class="content-section inspiration-section content-section--accent-2" id="inspiration" aria-labelledby="inspiration-title">
      <div class="section-heading">
        <p class="section-number">07</p>
        <div>
          <h2 id="inspiration-title">Inspiration</h2>
          <CopyButton sectionId="inspiration" label="Copy link to Inspiration" className="section-copy-button" />
        </div>
      </div>
      <div class="inspiration-grid">
        <div>
          {Object.values(skillSources).map((source) => (
            <article>
              <h3><a href={source.url} rel="noopener noreferrer" target="_blank">
                {source.label} <AnnotationIcon kind="reference" context="legend" />
              </a></h3>
              <p>{source.explanation}</p>
            </article>
          ))}
          <details class="other-sources">
            <summary>Other influences</summary>
            <a href="https://github.com/obra/superpowers/blob/main/skills/brainstorming/SKILL.md" rel="noopener noreferrer" target="_blank">
              Superpowers brainstorming · questions that affect the outcome <AnnotationIcon kind="reference" context="legend" />
            </a>
            <a href="https://github.com/Fission-AI/OpenSpec/blob/main/docs/concepts.md" rel="noopener noreferrer" target="_blank">
              OpenSpec · tracking changes to agreed behavior <AnnotationIcon kind="reference" context="legend" />
            </a>
            <a href="https://www.augmentcode.com/blog" rel="noopener noreferrer" target="_blank">
              Augment Code <AnnotationIcon kind="reference" context="legend" />
            </a>
            <a href="https://github.com/shadcn/improve" rel="noopener noreferrer" target="_blank">
              shadcn/improve <AnnotationIcon kind="reference" context="legend" />
            </a>
            <a href="https://developers.openai.com/blog/rethinking-skills-and-prompts-for-gpt-6-astra" rel="noopener noreferrer" target="_blank">
              OpenAI: Rethinking skills and prompts for GPT-6 Astra <AnnotationIcon kind="reference" context="legend" />
            </a>
          </details>
        </div>
      </div>
    </section>
      </div>
    </div>

  </main>

  <footer>
    <a href="/" class="footer-mark" aria-label="Simplest SDD home">
      <AnimatedWordmark variant="compact" decorative />
    </a>
    <p>Simplest spec-driven development.</p>
    <div class="footer-actions">
      <a
        class="footer-github"
        href="https://github.com/marcebollin/simplest-sdd"
        rel="noopener noreferrer"
        target="_blank"
      >GitHub <span aria-hidden="true">↗</span></a>
      <a class="footer-cta" href="#use-it">Try Simplest SDD <span aria-hidden="true">↑</span></a>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(.about-body) {
    background:
      radial-gradient(circle at 86% 4%, #1b1e1f 0, transparent 22rem),
      var(--bg);
    color: var(--ink);
  }

  .artifact-copy a:focus-visible,
  .inspiration-grid a:focus-visible,
  footer a:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: .3rem;
  }

  main,
  footer {
    width: min(100% - 2rem, 88rem);
    margin-inline: auto;
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, .6fr);
    gap: clamp(3rem, 8vw, 9rem);
    min-height: min(48rem, calc(100svh - 5.25rem));
    align-items: center;
    padding: clamp(5rem, 10vw, 9rem) 0 6rem;
  }

  .eyebrow,
  .section-number,
  .mini-heading {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font: 700 .7rem/1 var(--font-sans);
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .about-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3rem, 7vw, 7.2rem);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .9;
  }

  .hero-summary {
    max-width: 46rem;
    margin: 2.25rem 0 0;
    color: var(--ink-soft);
    font: 400 clamp(1.05rem, 1.5vw, 1.25rem)/1.7 var(--font-sans);
  }

  .loop-panel {
    align-self: end;
    margin-bottom: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .loop-panel ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .loop-panel li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: .72rem 0;
    border-bottom: 1px solid var(--line);
  }

  .loop-panel li span {
    color: #666a68;
    font: 600 .65rem/1 var(--font-mono);
  }

  .loop-panel li:nth-child(3n + 1) span,
  .step-grid li:nth-child(3n + 1) .step-number {
    color: var(--vinaceous-cinnamon);
  }

  .loop-panel li:nth-child(3n + 2) span,
  .step-grid li:nth-child(3n + 2) .step-number {
    color: var(--orange);
  }

  .loop-panel li:nth-child(3n) span,
  .step-grid li:nth-child(3n) .step-number {
    color: var(--dull-viridian-green);
  }

  .loop-panel li strong {
    font-size: 1.15rem;
    font-weight: 400;
  }

  .content-section {
    --section-accent: var(--vinaceous-cinnamon);
    padding: clamp(5rem, 10vw, 9rem) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 1rem;
  }

  .content-section:nth-of-type(3n + 2) {
    --section-accent: var(--vinaceous-cinnamon);
  }

  .content-section:nth-of-type(3n + 3) {
    --section-accent: var(--orange);
  }

  .content-section:nth-of-type(3n + 1) {
    --section-accent: var(--dull-viridian-green);
  }

  .content-section .section-number {
    color: var(--section-accent);
  }

  .section-heading {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .section-heading--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .section-heading--split > p {
    max-width: 25rem;
    margin: 0;
    color: var(--muted);
    font: 400 .95rem/1.6 var(--font-sans);
    text-align: right;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: .95;
  }

  .title-highlight {
    color: var(--vinaceous-cinnamon);
  }

  .title-highlight--orange {
    color: var(--orange);
  }

  .title-highlight--green {
    color: var(--dull-viridian-green);
  }

  .why-grid,
  .activation-grid,
  .inspiration-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 7vw, 7rem);
  }

  .artifact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .prose p {
    margin: 0 0 1.35rem;
    color: var(--ink-soft);
    font: 400 1rem/1.75 var(--font-sans);
  }

  .workflow-notes {
    max-width: 76ch;
    margin-top: 1.75rem;
  }

  .prose--large p {
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.62;
  }

  .principle-card {
    align-self: start;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .principle-card p {
    margin: 0 0 2.5rem;
    color: var(--muted);
    font: 600 .72rem/1 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .principle-card strong {
    display: block;
    font-size: clamp(1.5rem, 3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .step-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
    list-style: none;
  }

  .step-grid li {
    min-height: 18rem;
    padding: clamp(1.3rem, 3vw, 2rem);
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .step-grid li:last-child {
    grid-column: span 3;
    min-height: auto;
    display: grid;
    grid-template-columns: 4rem minmax(12rem, .7fr) minmax(16rem, 1fr);
    align-items: start;
    gap: 1.5rem;
  }

  .step-number {
    display: block;
    margin-bottom: 4rem;
    color: #656967;
    font: 600 .7rem/1 var(--font-mono);
  }

  .step-grid li:last-child .step-number {
    margin: .3rem 0 0;
  }

  .step-grid h3,
  .benefit-grid h3,
  .inspiration-grid h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .step-grid p,
  .benefit-grid p,
  .inspiration-grid article p {
    margin: 1rem 0 0;
    color: var(--muted);
    font: 400 .9rem/1.65 var(--font-sans);
  }

  .step-grid li:last-child p {
    margin-top: 0;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .benefit-grid article {
    min-height: 15rem;
    padding: 1.5rem;
    background: var(--bg);
  }

  .benefit-grid article:last-child {
    grid-column: span 2;
  }

  .benefit-grid article > span {
    display: block;
    width: .45rem;
    height: .45rem;
    margin-bottom: 3.5rem;
    border-radius: 50%;
    background: var(--ink-soft);
  }

  .benefit-grid article:nth-child(3n + 1) > span {
    background: var(--vinaceous-cinnamon);
  }

  .benefit-grid article:nth-child(3n + 2) > span {
    background: var(--orange);
  }

  .benefit-grid article:nth-child(3n) > span {
    background: var(--dull-viridian-green);
  }

  .activation-section {
    position: relative;
  }

  .activation-intro {
    margin: 0 0 1.25rem;
    color: var(--ink-soft);
    font: 400 1.1rem/1.5 var(--font-sans);
  }

  .activation-grid ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .activation-grid li {
    position: relative;
    padding: .95rem 1rem .95rem 2rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font: 400 .95rem/1.55 var(--font-sans);
  }

  .activation-grid li::before {
    content: "";
    position: absolute;
    top: 1.42rem;
    left: .25rem;
    width: .5rem;
    height: .5rem;
    border: 1px solid var(--muted);
    transform: rotate(45deg);
  }

  .activation-grid aside {
    align-self: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line-strong);
    background: var(--ink);
    color: var(--bg);
  }

  .activation-grid aside p,
  .activation-grid aside strong,
  .activation-grid aside span {
    display: block;
    margin: 0;
  }

  .activation-grid aside p {
    font: 700 .72rem/1 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .activation-grid aside strong {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -.05em;
    line-height: .9;
  }

  .activation-grid aside span {
    max-width: 30rem;
    font: 500 .9rem/1.6 var(--font-sans);
  }

  .instruction-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .instruction-grid > :global(.copy-instruction:nth-child(1)) {
    --card-accent: var(--vinaceous-cinnamon);
  }

  .instruction-grid > :global(.copy-instruction:nth-child(2)) {
    --card-accent: var(--orange);
  }

  .instruction-grid > :global(.copy-instruction:nth-child(3)) {
    --card-accent: var(--dull-viridian-green);
  }

  .tree-panel {
    min-width: 0;
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .panel-bar {
    min-height: 2.8rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: .65rem 1rem;

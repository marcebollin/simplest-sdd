---
import CopyButton from "../components/CopyButton.astro";
import CopyInstruction from "../components/CopyInstruction.astro";
import AnnotationIcon from "../components/AnnotationIcon.astro";
import AnimatedWordmark from "../components/AnimatedWordmark.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const steps = [
  {
    title: "Understands the project",
    description: "The agent inspects the repository, existing instructions, intended users, product goals, and testing approach before proposing changes."
  },
  {
    title: "Refines the request visibly",
    description: "It asks focused questions and names the specs and decisions it expects to consult or change."
  },
  {
    title: "Reuses an existing contract",
    description: "If a spec owns the behavior, it updates that contract automatically and reports the exact files changed."
  },
  {
    title: "Asks only before a new spec",
    description: "When no spec owns the behavior, it recommends creating a new one or continuing without one and waits for your choice."
  },
  {
    title: "Preserves sensitive approvals",
    description: "Migrations, data, auth, billing, security, public contracts, infrastructure, and active decisions retain explicit approval."
  },
  {
    title: "Implements and verifies",
    description: "It follows the new spec, refreshed existing spec, or refined no-new-spec request using the repository’s testing discipline."
  },
  {
    title: "Reports durable impact",
    description: "Every update names the specs and decisions consulted, unchanged, pending, or changed."
  }
];

const benefits = [
  ["Fewer expensive misunderstandings", "Review the intended outcome before reviewing a large code change."],
  ["Better continuity", "Future agents can find intent, boundaries, and decisions without replaying old conversations."],
  ["Human control at the right moments", "Reuse existing contracts automatically, ask before new ones, and keep sensitive technical approvals explicit."],
  ["Safer delegation", "Parallel work is suggested only for tasks with clear boundaries and independent verification."],
  ["Provider independence", "Recommend capabilities and reasoning effort instead of hard-coded model names."],
  ["A feedback loop", "Compare plans, routing choices, cost, verification, and outcomes over time."]
];

const activationTriggers = [
  "A business requirement or product behavior is changing and reviewing the expected result would take more than about five minutes",
  "Product behavior is meaningfully ambiguous",
  "A misunderstanding would be expensive",
  "Architecture, data, authentication, billing, security, or public contracts are involved",
  "Work will cross sessions or be delegated",
  "The behavior is already covered by an existing spec"
];

const projectTree = `AGENTS.md                         # canonical project instructions
CLAUDE.md                         # imports AGENTS.md for Claude
.agents/skills/spec-library/
├── SKILL.md                      # project-specific SDD workflow
├── index.html                    # browsable specification library
├── specs/<feature>/
│   ├── business.html             # why and what
│   ├── technical.html            # how and boundaries
│   ├── plan.html                 # tasks and verification
│   └── execution.json            # execution facts and outcomes
├── decisions/                    # durable decisions only
└── templates/                    # reusable document structure`;

const analyticsCommands = `npx simplest-sdd@latest analytics
npx simplest-sdd@latest analytics --format jsonl
npx simplest-sdd@latest analytics --format csv`;
---

<BaseLayout
  title="What is Simplest SDD?"
  description="Why Simplest SDD exists, how its lightweight spec-driven workflow works, and when it helps."
  canonicalPath="/about/"
  bodyClass="about-body"
>
  <SiteHeader current="about" />

  <main>
    <section class="about-hero" aria-labelledby="about-title">
      <h1 id="about-title"><span class="title-highlight title-highlight--orange">Structure</span> when it helps.</h1>
      <div class="about-hero__copy">
        <p class="hero-tagline"><span class="title-highlight title-highlight--orange">Nothing</span> when it doesn’t.</p>
        <p class="hero-summary">
          Simplest SDD is a small spec-driven development framework for building software with AI coding agents.
          It refines a feature request with you, refreshes an existing durable agreement when one owns the behavior,
          and asks before creating a new one.
        </p>
      </div>
    </section>

    <div class="about-layout">
      <aside class="about-map" aria-label="What is Simplest SDD sections">
        <ol>
          <li><a href="#why"><span>01</span>Why Simplest SDD?</a></li>
          <li><a href="#what-it-does"><span>02</span>What it does</a></li>
          <li><a href="#why-useful"><span>03</span>Why it is useful</a></li>
          <li><a href="#when-it-activates"><span>04</span>When it activates</a></li>
          <li><a href="#use-it"><span>05</span>How to use it</a></li>
          <li><a href="#project-output"><span>06</span>What it adds</a></li>
          <li><a href="#analytics"><span>07</span>Execution analytics</a></li>
          <li><a href="#inspiration"><span>08</span>Inspiration</a></li>
        </ol>
      </aside>

      <div class="about-sections">
    <section class="content-section why-section content-section--accent-1" id="why" aria-labelledby="why-title">
      <div class="section-heading">
        <p class="section-number">01</p>
        <div>
          <h2 id="why-title">Why Simplest SDD?</h2>
          <CopyButton sectionId="why" label="Copy link to Why Simplest SDD?" className="section-copy-button" />
        </div>
      </div>
      <div class="why-grid">
        <div class="prose prose--large">
          <p>
            AI agents can write code quickly. The harder problem is confidence: did the agent understand the
            request, respect the project, make the right tradeoffs, and verify the result?
          </p>
          <p>
            Long prompts disappear into conversation history and mix product intent with implementation details.
            Heavy specification systems can solve part of that problem, but often turn every change into ceremony.
          </p>
        </div>
        <aside class="principle-card">
          <p>The point is not more documentation.</p>
          <strong>It is less guessing, clearer control, and project knowledge that survives the session.</strong>
        </aside>
      </div>
    </section>

    <section class="content-section content-section--accent-2" id="what-it-does" aria-labelledby="how-title">
      <div class="section-heading">
        <p class="section-number">02</p>
        <div>
          <h2 id="how-title">What it does</h2>
          <CopyButton sectionId="what-it-does" label="Copy link to What it does" className="section-copy-button" />
        </div>
        <span>Seven steps from visible discovery to durable, current contracts.</span>
      </div>
      <ol class="step-grid">
        {steps.map((step, index) => (
          <li>
            <div class="step-heading">
              <span class="step-number">{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
            </div>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="content-section content-section--accent-3" id="why-useful" aria-labelledby="useful-title">
      <div class="section-heading">
        <p class="section-number">03</p>
        <div>
          <h2 id="useful-title">Why it is useful</h2>
          <CopyButton sectionId="why-useful" label="Copy link to Why it is useful" className="section-copy-button" />
        </div>
      </div>
      <div class="benefit-grid">
        {benefits.map(([title, description]) => (
          <article>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section activation-section content-section--accent-1" id="when-it-activates" aria-labelledby="activation-title">
      <div class="section-heading">
        <p class="section-number">04</p>
        <div>
          <h2 id="activation-title">When it activates</h2>
          <CopyButton sectionId="when-it-activates" label="Copy link to When it activates" className="section-copy-button" />
        </div>
      </div>
      <div class="activation-grid">
        <div>
          <p class="activation-intro">The mandatory discovery round activates when:</p>
          <ul>
            {activationTriggers.map((trigger) => <li>{trigger}</li>)}
          </ul>
        </div>
        <aside>
          <p>No business behavior change?</p>
          <strong>Just build it.</strong>
          <span>
            Purely presentational design, styling, spacing, or layout changes should be implemented directly even
            when visual review takes more than five minutes, unless another trigger applies. After discovery, an
            owning spec updates automatically; you choose only when a new spec would be created.
          </span>
        </aside>
      </div>
    </section>

    <section class="content-section content-section--accent-2" id="use-it" aria-labelledby="use-title">
      <div class="section-heading">
        <p class="section-number">05</p>
        <div>
          <h2 id="use-title">How to use it</h2>
          <CopyButton sectionId="use-it" label="Copy link to How to use it" className="section-copy-button" />
        </div>
        <span>Copy one instruction and give it to your coding agent.</span>
      </div>
      <div class="instruction-grid">
        <CopyInstruction
          label="Install"
          action="init"
          description="Add the framework to the project your agent is currently working in."
        />
        <CopyInstruction
          label="Update"
          action="update"
          description="Bring an existing installation forward without losing project knowledge."
        />
        <CopyInstruction
          label="Remove"
          action="remove"
          description="Deactivate the framework while preserving project-owned specs and decisions."
        />
      </div>
    </section>

    <section class="content-section content-section--accent-3" id="project-output" aria-labelledby="project-title">
      <div class="section-heading">
        <p class="section-number">06</p>
        <div>
          <h2 id="project-title">What it adds to a project</h2>
          <CopyButton sectionId="project-output" label="Copy link to What it adds to a project" className="section-copy-button" />
        </div>
      </div>
      <div class="artifact-grid">
        <div class="tree-panel">
          <div class="panel-bar">
            <span>spec library</span>
            <span>plain static files</span>
          </div>
          <pre><code>{projectTree}</code></pre>
        </div>
        <div class="artifact-copy prose">
          <p>
            The library stays readable by people and agents. <code>AGENTS.md</code> and
            <code>.agents/skills</code> are the source of truth, with a compatibility link for Claude skills.
          </p>
          <p>
            Business intent, technical boundaries, execution details, and durable decisions use distinct semantic
            colors and restrained highlights. Explicit relationship links explain which document to read next and why.
          </p>
          <a
            href="https://github.com/marcebollin/simplest-sdd/tree/main/examples"
            rel="noopener noreferrer"
            target="_blank"
          >
            Explore the generated examples <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section class="content-section analytics-section content-section--accent-1" id="analytics" aria-labelledby="analytics-title">
      <div class="section-heading">
        <p class="section-number">07</p>
        <div>
          <h2 id="analytics-title">Execution analytics</h2>
          <CopyButton sectionId="analytics" label="Copy link to Execution analytics" className="section-copy-button" />
        </div>
      </div>
      <div class="analytics-grid">
        <div class="prose">
          <p>
            Validate and summarize the execution records stored with each feature. Compare plans, routing choices,
            models, token use, verification, and outcomes using facts from real runs.
          </p>
          <p class="muted-note">The goal is a better feedback loop—not reporting work for its own sake.</p>
        </div>
        <div class="command-panel">
          <div class="panel-bar">
            <span>terminal</span>
            <CopyButton text={analyticsCommands} label="Copy analytics commands" />
          </div>
          <pre><code>{analyticsCommands}</code></pre>
          <p>
            Local Codex usage:
            <code>npx simplest-sdd@latest codex-usage --session &lt;session-id&gt;</code>
          </p>
        </div>
      </div>
    </section>

    <section class="content-section inspiration-section content-section--accent-2" id="inspiration" aria-labelledby="inspiration-title">
      <div class="section-heading">
        <p class="section-number">08</p>
        <div>
          <h2 id="inspiration-title">Inspiration</h2>
          <CopyButton sectionId="inspiration" label="Copy link to Inspiration" className="section-copy-button" />
        </div>
      </div>
      <div class="inspiration-grid">
        <div>
          <a href="https://www.augmentcode.com/blog" rel="noopener noreferrer" target="_blank">
            Augment Code <AnnotationIcon kind="reference" context="legend" />
          </a>
          <a href="https://www.youtube.com/@t3dotgg" rel="noopener noreferrer" target="_blank">
            Theo’s videos <AnnotationIcon kind="reference" context="legend" />
          </a>
          <a href="https://github.com/shadcn/improve" rel="noopener noreferrer" target="_blank">
            shadcn/improve <AnnotationIcon kind="reference" context="legend" />
          </a>
        </div>
      </div>
      <aside class="disclaimer">
        <span>One friendly disclaimer</span>
        <p>
          I have not read up on loop engineering yet, so it has not shaped this framework. Give me a chance—I will
          get there.
        </p>
      </aside>
    </section>
      </div>
    </div>

    <section class="closing-section" aria-labelledby="closing-title">
      <h2 id="closing-title">
        <span class="title-highlight title-highlight--orange">Understand</span> before building.<br /><span class="title-highlight title-highlight--orange">Approve</span> before acting.<br /><span class="title-highlight title-highlight--orange">Verify</span> before declaring success.
      </h2>
    </section>
  </main>

  <footer>
    <a href="/" class="footer-mark" aria-label="Simplest SDD home">
      <AnimatedWordmark variant="compact" decorative />
    </a>
    <p>Simplest spec-driven development.</p>
    <div class="footer-actions">
      <a
        class="footer-github"
        href="https://github.com/marcebollin/simplest-sdd"
        rel="noopener noreferrer"
        target="_blank"
      >GitHub <span aria-hidden="true">↗</span></a>
      <a class="footer-cta" href="#use-it">Try Simplest SDD <span aria-hidden="true">↑</span></a>
    </div>
  </footer>
</BaseLayout>

<style>
  :global(.about-body) {
    background:
      radial-gradient(circle at 86% 4%, #1b1e1f 0, transparent 22rem),
      var(--bg);
    color: var(--ink);
  }

  .artifact-copy a:focus-visible,
  .inspiration-grid a:focus-visible,
  footer a:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: .3rem;
  }

  main,
  footer {
    width: min(100% - 2rem, 88rem);
    margin-inline: auto;
  }

  .about-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(18rem, .6fr);
    gap: clamp(3rem, 8vw, 9rem);
    min-height: min(48rem, calc(100svh - 5.25rem));
    align-items: center;
    padding: clamp(5rem, 10vw, 9rem) 0 6rem;
  }

  .eyebrow,
  .section-number,
  .mini-heading {
    margin: 0 0 1.25rem;
    color: var(--muted);
    font: 700 .7rem/1 var(--font-sans);
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .about-hero h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--ink);
    font-size: clamp(3rem, 7vw, 7.2rem);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .9;
  }

  .hero-summary {
    max-width: 46rem;
    margin: 2.25rem 0 0;
    color: var(--ink-soft);
    font: 400 clamp(1.05rem, 1.5vw, 1.25rem)/1.7 var(--font-sans);
  }

  .loop-panel {
    align-self: end;
    margin-bottom: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .loop-panel ol {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .loop-panel li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: .72rem 0;
    border-bottom: 1px solid var(--line);
  }

  .loop-panel li span {
    color: #666a68;
    font: 600 .65rem/1 var(--font-mono);
  }

  .loop-panel li:nth-child(3n + 1) span,
  .step-grid li:nth-child(3n + 1) .step-number {
    color: var(--vinaceous-cinnamon);
  }

  .loop-panel li:nth-child(3n + 2) span,
  .step-grid li:nth-child(3n + 2) .step-number {
    color: var(--orange);
  }

  .loop-panel li:nth-child(3n) span,
  .step-grid li:nth-child(3n) .step-number {
    color: var(--dull-viridian-green);
  }

  .loop-panel li strong {
    font-size: 1.15rem;
    font-weight: 400;
  }

  .content-section {
    --section-accent: var(--vinaceous-cinnamon);
    padding: clamp(5rem, 10vw, 9rem) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: 1rem;
  }

  .content-section:nth-of-type(3n + 2) {
    --section-accent: var(--vinaceous-cinnamon);
  }

  .content-section:nth-of-type(3n + 3) {
    --section-accent: var(--orange);
  }

  .content-section:nth-of-type(3n + 1) {
    --section-accent: var(--dull-viridian-green);
  }

  .content-section .section-number {
    color: var(--section-accent);
  }

  .section-heading {
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .section-heading--split {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .section-heading--split > p {
    max-width: 25rem;
    margin: 0;
    color: var(--muted);
    font: 400 .95rem/1.6 var(--font-sans);
    text-align: right;
  }

  .section-heading h2,
  .closing-section h2 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 5.5rem);
    font-weight: 400;
    letter-spacing: -.045em;
    line-height: .95;
  }

  .title-highlight {
    color: var(--vinaceous-cinnamon);
  }

  .title-highlight--orange {
    color: var(--orange);
  }

  .title-highlight--green {
    color: var(--dull-viridian-green);
  }

  .why-grid,
  .activation-grid,
  .artifact-grid,
  .analytics-grid,
  .inspiration-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 7vw, 7rem);
  }

  .prose p {
    margin: 0 0 1.35rem;
    color: var(--ink-soft);
    font: 400 1rem/1.75 var(--font-sans);
  }

  .prose--large p {
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.62;
  }

  .principle-card {
    align-self: start;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .principle-card p {
    margin: 0 0 2.5rem;
    color: var(--muted);
    font: 600 .72rem/1 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .principle-card strong {
    display: block;
    font-size: clamp(1.5rem, 3vw, 2.6rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .step-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
    list-style: none;
  }

  .step-grid li {
    min-height: 18rem;
    padding: clamp(1.3rem, 3vw, 2rem);
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .step-grid li:last-child {
    grid-column: span 3;
    min-height: auto;
    display: grid;
    grid-template-columns: 4rem minmax(12rem, .7fr) minmax(16rem, 1fr);
    align-items: start;
    gap: 1.5rem;
  }

  .step-number {
    display: block;
    margin-bottom: 4rem;
    color: #656967;
    font: 600 .7rem/1 var(--font-mono);
  }

  .step-grid li:last-child .step-number {
    margin: .3rem 0 0;
  }

  .step-grid h3,
  .benefit-grid h3,
  .inspiration-grid h3 {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .step-grid p,
  .benefit-grid p,
  .inspiration-grid article p {
    margin: 1rem 0 0;
    color: var(--muted);
    font: 400 .9rem/1.65 var(--font-sans);
  }

  .step-grid li:last-child p {
    margin-top: 0;
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .benefit-grid article {
    min-height: 15rem;
    padding: 1.5rem;
    background: var(--bg);
  }

  .benefit-grid article:last-child {
    grid-column: span 2;
  }

  .benefit-grid article > span {
    display: block;
    width: .45rem;
    height: .45rem;
    margin-bottom: 3.5rem;
    border-radius: 50%;
    background: var(--ink-soft);
  }

  .benefit-grid article:nth-child(3n + 1) > span {
    background: var(--vinaceous-cinnamon);
  }

  .benefit-grid article:nth-child(3n + 2) > span {
    background: var(--orange);
  }

  .benefit-grid article:nth-child(3n) > span {
    background: var(--dull-viridian-green);
  }

  .activation-section {
    position: relative;
  }

  .activation-intro {
    margin: 0 0 1.25rem;
    color: var(--ink-soft);
    font: 400 1.1rem/1.5 var(--font-sans);
  }

  .activation-grid ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .activation-grid li {
    position: relative;
    padding: .95rem 1rem .95rem 2rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
    font: 400 .95rem/1.55 var(--font-sans);
  }

  .activation-grid li::before {
    content: "";
    position: absolute;
    top: 1.42rem;
    left: .25rem;
    width: .5rem;
    height: .5rem;
    border: 1px solid var(--muted);
    transform: rotate(45deg);
  }

  .activation-grid aside {
    align-self: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--line-strong);
    background: var(--ink);
    color: var(--bg);
  }

  .activation-grid aside p,
  .activation-grid aside strong,
  .activation-grid aside span {
    display: block;
    margin: 0;
  }

  .activation-grid aside p {
    font: 700 .72rem/1 var(--font-sans);
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .activation-grid aside strong {
    font-size: clamp(3rem, 7vw, 6rem);
    font-weight: 400;
    letter-spacing: -.05em;
    line-height: .9;
  }

  .activation-grid aside span {
    max-width: 30rem;
    font: 500 .9rem/1.6 var(--font-sans);
  }

  .instruction-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .instruction-grid > :global(.copy-instruction:nth-child(1)) {
    --card-accent: var(--vinaceous-cinnamon);
  }

  .instruction-grid > :global(.copy-instruction:nth-child(2)) {
    --card-accent: var(--orange);
  }

  .instruction-grid > :global(.copy-instruction:nth-child(3)) {
    --card-accent: var(--dull-viridian-green);
  }

  .tree-panel,
  .command-panel {
    min-width: 0;
    border: 1px solid var(--line-strong);
    background: var(--surface);

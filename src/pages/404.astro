---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found — Simplest SDD"
  description="The requested Simplest SDD page could not be found."
  canonicalPath="/404.html"
  bodyClass="not-found-body"
>
  <main>
    <p>404</p>
    <h1>This page missed the spec.</h1>
    <a href="/">Return to the landing page <span aria-hidden="true">→</span></a>
  </main>
</BaseLayout>

<style>
  :global(.not-found-body) {
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 50% 35%, #151718 0, var(--bg) 55%);
  }

  main {
    width: min(100% - 2rem, 48rem);
    text-align: center;
  }

  p {
    margin: 0 0 1rem;
    color: var(--muted);
    font: 700 .75rem/1 var(--font-sans);
    letter-spacing: .18em;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .95;
  }

  a {
    display: inline-flex;
    gap: .6rem;
    padding: .9rem 1rem;
    margin-top: 2.5rem;
    border: 1px solid var(--line-strong);
    color: var(--ink-soft);
    font: 650 .78rem/1 var(--font-sans);
    text-decoration: none;
  }

  a:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: .3rem;
  }
</style>

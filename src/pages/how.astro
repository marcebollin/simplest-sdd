---
import initPromptRaw from "../../prompts/init.md?raw";
import removePromptRaw from "../../prompts/remove.md?raw";
import updatePromptRaw from "../../prompts/update.md?raw";
import packageInfo from "../../package.json";
import schemaVersions from "../../schema/versions.json";
import AnnotationIcon from "../components/AnnotationIcon.astro";
import AnimatedWordmark from "../components/AnimatedWordmark.astro";
import CopyButton from "../components/CopyButton.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type Reference = {
  label: string;
  url: string;
  explanation?: string;
};

type Annotation = {
  explanation: string;
  tone: string;
  reference?: Reference;
};

const initAnnotations: Record<string, Annotation> = {
  "Start here": {
    explanation: "Names the job, pins the schema version, and tells the agent exactly which repository it is changing before any decisions are made.",
    tone: "slate"
  },
  "Rules": {
    explanation: "Sets the non-negotiable safety and compatibility boundaries. These rules stop installation work from erasing local instructions, expanding scope, or quietly starting product work.",
    tone: "rose"
  },
  "1. Inspect And Discover The Testing Discipline": {
    explanation: "Makes the framework adapt to the repository instead of imposing a universal testing ritual. Existing instructions win; new tooling is offered only when no discipline can be found.",
    tone: "blue"
  },
  "2. Ask The Project Discovery Questions": {
    explanation: "Asks at least eight material project, product, and workflow questions in one round and waits for all answers before editing files. Questions for a missing concrete goal or clues/examples are additional. Known facts inform sharper questions rather than requests to repeat them.",
    tone: "violet"
  },
  "3. Make `AGENTS.md` Canonical Without Losing Content": {
    explanation: "Keeps project facts, local constraints, and concise skill routing in one canonical file. Detailed workflow rules belong in the skill’s references, while compatibility files point back to the same project guidance.",
    tone: "amber",
    reference: {
      label: "Theo’s spec-driven development video",
      url: "https://youtu.be/xJaMTo2YgO8?si=o9SUsf9VfLzoF1SL",
      explanation: "Theo’s video helped shape the product and business discovery questions, including the prompt’s explicit model of the project’s intended users."
    }
  },
  "4. Create The Canonical Spec Skill": {
    explanation: "Creates a short skill entrypoint that routes to discovery, authoring, and execution references. Future agents load only the guidance needed for the current phase; HTML templates remain output assets instead of always-loaded instructions.",
    tone: "indigo",
    reference: {
      label: "OpenAI: Rethinking skills and prompts for GPT-6 Astra",
      url: "https://developers.openai.com/blog/rethinking-skills-and-prompts-for-gpt-6-astra",
      explanation: "The article informed smaller instruction entrypoints, selective context loading, and removing workflow steps that repeat settled decisions."
    }
  },
  "Gate": {
    explanation: "Keeps the framework lightweight. Substantive, ambiguous, risky, or handed-off work receives discovery, while small and presentation-only changes proceed directly.",
    tone: "amber",
    reference: {
      label: "Augment Code: What Is Spec-Driven Development?",
      url: "https://www.augmentcode.com/guides/what-is-spec-driven-development"
    }
  },
  "Resolve Context": {
    explanation: "Starts with task-relevant repository facts and uses indexes to find owning specs and applicable decisions. Existing conversation supplies settled answers and authorization; broader reading is justified by a concrete unknown.",
    tone: "blue",
    reference: {
      label: "shadcn/improve",
      url: "https://github.com/shadcn/improve"
    }
  },
  "Analyze Related Implementations And Reuse": {
    explanation: "Checks real code, callers, and tests before proposing consequential reuse tradeoffs. Those choices receive alternatives and one reasoned recommendation; an earlier explicit choice counts. Routine compatible reuse proceeds directly, and no useful candidate means no forced options or abstraction.",
    tone: "blue"
  },
  "Refine Request: Resolve Material Unknowns": {
    explanation: "Each newly activated request gets at least five material refinement questions in one round, with all answers required before documentation-branch decisions or implementation, even for clear existing-spec or no-new-spec work. Missing goal or clues/examples questions are extra. A reuse choice can count; a completed qualifying round need not be replayed for an unchanged request on resume.",
    tone: "violet"
  },
  "Resolve The Spec Branch After Discovery": {
    explanation: "Refreshes an owning spec automatically. When none exists, ask whether to create a spec only if the user has not already chosen; a newly generated business spec still needs approval before implementation. Skipping a new spec still preserves approved reuse choices in canonical decisions and indexes without creating feature artifacts.",
    tone: "amber"
  },
  "Preserve Independent Technical Approvals": {
    explanation: "Keeps approval tied to concrete sensitive changes rather than topic keywords. Prior explicit authorization counts for its stated scope; only unresolved changes pause dependent implementation. Documentation selection alone grants no technical approval.",
    tone: "rose"
  },
  "HTML Artifacts": {
    explanation: "Makes the body as readable as the headings: focused paragraphs, useful list lead-ins, semantic bold and italic emphasis, inline code, and sparse highlights. The author chooses formatting from the content, without keyword matching or formatting quotas, and preserves exact requirements and meaning without color.",
    tone: "teal"
  },
  "Create One Feature Folder": {
    explanation: "Separates the product contract, technical design, and implementation handoff. Each reader can load the layer it needs without carrying the whole history.",
    tone: "teal"
  },
  "Connect Documents With Explicit Relationships": {
    explanation: "Makes cross-document context deliberate. Every link names the target’s role and why it matters, while precise criteria prevent topic similarity from turning the library into a noisy web.",
    tone: "cyan"
  },
  "Record Decision Impact Without Creating Ceremony": {
    explanation: "Records every approved reuse-analysis choice, including separate implementations and work without a new spec. The decision captures alternatives, rationale, scope, approval, and implementation state; approved intent starts as pending and is reconciled with what shipped. Other decisions remain selective, and active-decision changes keep their technical approval gate.",
    tone: "green"
  },
  "Choose An Execution Strategy": {
    explanation: "Defaults to same-session execution and allows useful bounded parallel work where tools and local constraints permit it. Explicit delegation, model, cost, and stop instructions still govern. A strategy menu, capability profiles, and detailed packets are used only when they help resolve a real choice or assignment.",
    tone: "cyan",
    reference: {
      label: "shadcn/improve",
      url: "https://github.com/shadcn/improve"
    }
  },
  "Implement And Verify": {
    explanation: "Completes authorized implementation and documentation close-out under the repository’s real testing discipline. Scope checks to the change, expand verification when evidence warrants it, and honor explicit stop points. Delegation adds review responsibility without granting permission for commits, merges, or deployment.",
    tone: "yellow",
    reference: {
      label: "shadcn/improve",
      url: "https://github.com/shadcn/improve"
    }
  },
  "Close Out And Self-Improve": {
    explanation: "Reconciles the specs and approved reuse decisions with the verified result, then reports the outcome, evidence, limitations, and exact documentation impact. Improve skill guidance only from reusable observed friction, with no execution telemetry or rating question.",
    tone: "green"
  },
  "Root Library Index": {
    explanation: "Provides progressive disclosure for humans and agents. The index helps a reader choose the relevant artifact without loading every spec, decision, and plan.",
    tone: "teal"
  },
  "5. Create Concise HTML Templates": {
    explanation: "Shows body-level hierarchy through illustrative paragraphs and lists: business commitments and acceptance criteria, technical boundaries and identifiers, ordered plan actions, and decision tradeoffs. Examples guide editorial judgment rather than impose a fixed pattern; real documents replace the sample facts and remove their illustrative labels.",
    tone: "indigo",
    reference: {
      label: "Theo’s spec-driven development video",
      url: "https://youtu.be/xJaMTo2YgO8?si=o9SUsf9VfLzoF1SL",
      explanation: "Theo’s video directly informed the HTML-first artifact strategy: readable, self-contained documents instead of basic Markdown templates."
    }
  },
  "6. Add Claude Compatibility": {
    explanation: "Keeps the canonical instructions and skill usable from Claude without maintaining a second copy. The relative link makes both agent environments resolve the same workflow.",
    tone: "violet"
  },
  "7. Validate": {
    explanation: "Checks that installation produced a coherent system: the links resolve, the schema marker is current, history survived, and the agent stops at the requested boundary.",
    tone: "lime"
  }
};

const updateAnnotations: Record<string, Annotation> = {
  "Start here": {
    explanation: "Defines the migration target and explains that the CLI generates state and changelog blocks for the current installation. Current rules override historical tracking and rating instructions, so upgrades from older versions never recreate intermediate execution records or telemetry.",
    tone: "slate"
  },
  "Rules": {
    explanation: "Focuses this update on the generated skill and AGENTS.md, preserving project facts, local constraints, specs, plans, and decisions. Retains or restores the eight-question installation and five-question feature discovery minimums while removing mandatory strategy pauses. Old execution records stay untouched unless the user selects deletion.",
    tone: "rose"
  },
  "1. Inspect Current Installation": {
    explanation: "Establishes what is actually installed before changing it: schema marker, compatibility links, document formats, testing discipline, local customizations, and durable project data.",
    tone: "blue"
  },
  "2. Audit The Skill And Agent Guidance": {
    explanation: "Audits the actual installed skill and generated AGENTS.md against the current contract. Separates obsolete framework defaults from genuine local policy, then defines focused changes to routing, discovery, authoring, execution, and completion without replaying every historical version.",
    tone: "violet"
  },
  "3. Choose What To Do With Old Execution Records": {
    explanation: "Lists the exact legacy record and ledger paths and offers preservation or deletion. Preservation leaves them byte-for-byte unchanged as inactive history; deletion requires an explicit choice covering those files. Silence preserves them while other updates continue. No records means no cleanup question, and spec folders, plans, and decisions remain intact.",
    tone: "amber"
  },
  "4. Apply The Migration Conservatively": {
    explanation: "Moves detailed workflow guidance into discovery, authoring, and execution references, leaving concise AGENTS.md routing and a short skill entrypoint. Removes duplicate rules and mandatory strategy menus while retaining the discovery minimums, local constraints, approvals, approved reuse decisions, and history. Migrating instruction files does not rerun bootstrap discovery.",
    tone: "amber"
  },
  "5. Validate": {
    explanation: "Proves that the upgraded workflow is coherent and current without losing project knowledge, changing unrelated behavior, or continuing into feature delivery.",
    tone: "lime"
  }
};

const removeAnnotations: Record<string, Annotation> = {
  "Start here": {
    explanation: "Defines removal as deactivation, not erasure. The goal is to stop Simplest SDD from loading while treating project-specific documents as user-owned work.",
    tone: "slate"
  },
  "Rules": {
    explanation: "Creates a strict ownership boundary: clearly generated configuration can be removed, but durable or ambiguous content is preserved unless the user explicitly confirms deletion.",
    tone: "rose"
  },
  "1. Inspect Ownership": {
    explanation: "Classifies every relevant file before editing so the agent can distinguish framework activation from specifications, decisions, plans, and history that now belong to the project.",
    tone: "blue"
  },
  "2. Remove Agent Activation": {
    explanation: "Stops agents from loading the Simplest SDD workflow by removing only its activation instructions and compatibility link, while leaving unrelated agent guidance intact.",
    tone: "violet"
  },
  "3. Deactivate The Skill Without Losing User Data": {
    explanation: "Removes the reusable skill and untouched templates when safe, but keeps specifications, decisions, plans, any legacy execution records, and customized material by default.",
    tone: "amber"
  },
  "4. Validate": {
    explanation: "Confirms that the framework is inactive and that user-owned knowledge survived. Any remaining references are reported instead of silently deleted.",
    tone: "lime"
  }
};

function slugify(value: string) {
  return value
    .toLowerCase()
    .replace(/`/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

type PromptSection = {
  title: string;
  id: string;
  level: number;
  startLine: number;
  lines: string[];
  annotation: Annotation;
};

function parsePrompt(promptId: string, rawPrompt: string, annotations: Record<string, Annotation>) {
  const source = rawPrompt.replace(/\r\n/g, "\n").replace(/\n$/, "");
  const lines = source.split("\n");
  const sections: PromptSection[] = [];
  let inFence = false;
  let current: PromptSection = {
    title: "Start here",
    id: `${promptId}-start-here`,
    level: 1,
    startLine: 1,
    lines: [],
    annotation: annotations["Start here"]
  };

  for (const [index, line] of lines.entries()) {
    const fenceLine = line.trimStart().startsWith("```");
    const heading = !inFence ? line.match(/^(##|###)\s+(.+)$/) : null;

    if (heading && current.lines.length > 0) {
      sections.push(current);
      const title = heading[2];
      current = {
        title,
        id: `${promptId}-${slugify(title)}`,
        level: heading[1].length,
        startLine: index + 1,
        lines: [],
        annotation: annotations[title] ?? {
          explanation: "This section is part of the workflow. Refine this explanation as the framework evolves.",
          tone: "slate"
        }
      };
    }

    current.lines.push(line);
    if (fenceLine) inFence = !inFence;
  }

  sections.push(current);
  return {
    source,
    lines,
    sections,
    wordCount: source.trim().split(/\s+/).length
  };
}

const promptDefinitions = [
  {
    id: "init",
    tabLabel: "Install",
    actionLabel: "installation",
    summary: "Creates concise project routing, a short skill entrypoint, and references for discovery, authoring, and execution, with approvals tied to concrete choices and changes.",
    instruction: "Run npx simplest-sdd@latest init and follow the instructions",
    rawUrl: "/init-prompt.txt",
    githubUrl: "https://github.com/marcebollin/simplest-sdd/blob/main/prompts/init.md",
    prompt: parsePrompt("init", initPromptRaw, initAnnotations)
  },
  {
    id: "update",
    tabLabel: "Update",
    actionLabel: "migration",
    summary: "Improves the generated skill and AGENTS.md with focused references and proportional verification while retaining the eight-question installation and five-question feature discovery minimums. Preserves existing approvals, local context, specifications, plans, decisions, and old execution records unless deletion is explicitly selected.",
    instruction: "Run npx simplest-sdd@latest update and follow the instructions",
    rawUrl: "/update-prompt.txt",
    githubUrl: "https://github.com/marcebollin/simplest-sdd/blob/main/prompts/update.md",
    prompt: parsePrompt("update", updatePromptRaw, updateAnnotations)
  },
  {
    id: "remove",
    tabLabel: "Remove",
    actionLabel: "removal",
    summary: "Deactivates the framework conservatively while preserving specifications, decisions, plans, and any legacy execution records owned by the project.",
    instruction: "Run npx simplest-sdd@latest remove and follow the instructions",
    rawUrl: "/remove-prompt.txt",
    githubUrl: "https://github.com/marcebollin/simplest-sdd/blob/main/prompts/remove.md",
    prompt: parsePrompt("remove", removePromptRaw, removeAnnotations)
  }
];

const currentRelease = schemaVersions.versions.find(
  (release) => release.version === schemaVersions.currentSchemaVersion
);
---

<BaseLayout
  title="How Simplest SDD works"
  description="A color-coded, annotated tour of the install, update, and removal prompts used by the Simplest SDD CLI."
  canonicalPath="/how/"
  bodyClass="how-body"
>
  <SiteHeader current="how" />

  <main>
    <section class="how-hero" aria-labelledby="how-title">
      <h1 id="how-title">
        Because we should read the <span class="title-highlight title-highlight--orange">skills</span> we install, I made this one easy to{" "}
        <span class="title-highlight title-highlight--orange">explore</span>.
      </h1>

      <div class="version-strip" aria-label="Documented Simplest SDD version">
        <div>
          <span>CLI package</span>
          <strong>v{packageInfo.version}</strong>
        </div>
        <div>
          <span>Schema</span>
          <strong>v{schemaVersions.currentSchemaVersion}</strong>
        </div>
        <div>
          <span>Schema date</span>
          <strong>{currentRelease?.date ?? "Current"}</strong>
        </div>
        <p>
          {currentRelease?.summary} These views import the same Markdown templates used by the CLI. At runtime,
          the CLI fills version, detected installation state, and relevant migration history for the repository
          where it runs.
        </p>
      </div>
    </section>

    <section class="prompt-overview" aria-label="Prompt overview">
      <div class="prompt-tabs" role="tablist" aria-label="Choose a Simplest SDD prompt">
        {promptDefinitions.map((definition, index) => (
          <button
            aria-controls={`${definition.id}-prompt-panel`}
            aria-selected={index === 0 ? "true" : "false"}
            data-prompt-tab={definition.id}
            id={`${definition.id}-prompt-tab`}
            role="tab"
            tabindex={index === 0 ? 0 : -1}
            type="button"
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            {definition.tabLabel}
          </button>
        ))}
      </div>

      {promptDefinitions.map((definition, definitionIndex) => {
        const { prompt } = definition;

        return (
          <div data-prompt-summary={definition.id} hidden={definitionIndex !== 0}>
            <div class="hero-bottom">
              <p>
                <strong>{definition.tabLabel}:</strong> {definition.summary} Every color marks a different
                responsibility. Hover, focus, or click the <strong>i</strong> to see why a section exists.
              </p>
              <div class="prompt-actions">
                <a href={definition.rawUrl}>View raw prompt</a>
                <a href={definition.githubUrl} rel="noopener noreferrer" target="_blank">
                  GitHub source <span aria-hidden="true">↗</span>
                </a>
                <CopyButton
                  text={definition.instruction}
                  label={`Copy the ${definition.id} CLI instruction`}
                  className="copy-full-prompt"
                  displayText="Copy prompt"
                  confirmedText="Copy prompt"
                />
              </div>
            </div>
          </div>
        );
      })}
    </section>

    {promptDefinitions.map((definition, definitionIndex) => {
      const { prompt } = definition;
      const guideTitleId = `${definition.id}-guide-title`;

      return (
        <section
          aria-labelledby={`${definition.id}-prompt-tab`}
          data-prompt-panel={definition.id}
          hidden={definitionIndex !== 0}
          id={`${definition.id}-prompt-panel`}
          role="tabpanel"
          tabindex="0"
        >
          <section class="guide-intro" aria-labelledby={guideTitleId}>
            <div class="guide-intro__content">
              <div class="guide-intro__heading">
                <h2 id={guideTitleId}>
                  The whole <span class="title-highlight title-highlight--orange">prompt</span>, with the{" "}
                  <span class="title-highlight title-highlight--orange">why</span> attached.
                </h2>
                <div class="legend" aria-label="Annotation legend">
                  <span><AnnotationIcon kind="why" /> Why this part exists</span>
                  <span><AnnotationIcon kind="reference" /> Inspiration source</span>
                </div>
              </div>
              <div
                class="prompt-facts"
                aria-label={`${definition.tabLabel} prompt facts`}
                data-prompt-summary={definition.id}
                hidden={definitionIndex !== 0}
              >
                <span>{prompt.lines.length} lines</span>
                <span>{prompt.wordCount.toLocaleString("en-US")} words</span>
                <span>{prompt.sections.length} explained parts</span>
              </div>
            </div>
          </section>

          <div class="prompt-layout">
            <aside class="prompt-map">
              <ol>
                {prompt.sections.map((section, index) => (
                  <li class:list={[section.level === 3 && "prompt-map__subsection"]}>
                    <a href={`#${section.id}`}>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      {section.title}
                    </a>
                  </li>
                ))}
              </ol>
            </aside>

            <div class="prompt-sections">
              {prompt.sections.map((section, index) => {
                const endLine = section.startLine + section.lines.length - 1;
                const explanationId = `${section.id}-explanation`;
                const referenceId = `${section.id}-reference`;
                const referenceExplanation = section.annotation.reference?.explanation
                  ?? (section.annotation.reference?.url.includes("augmentcode.com")
                    ? "Augment Code’s guide provides the spec-driven development model behind this approval-gated workflow."
                    : section.annotation.reference?.url.includes("shadcn/improve")
                      ? "shadcn/improve informed the framework’s approach to focused context, bounded execution, and verification."
                      : "This source directly informed the design of this part of the workflow.");

                return (
                  <article
                    class:list={["prompt-section", `prompt-section--accent-${(index % 3) + 1}`]}
                    id={section.id}
                  >
                    <header class="prompt-section__header">
                      <div>
                        <span class="prompt-section__index">{String(index + 1).padStart(2, "0")}</span>
                        <h3>{section.title}</h3>
                        <CopyButton
                          sectionId={section.id}
                          label={`Copy link to ${section.title}`}
                          className="section-copy-button"
                        />
                      </div>
                      <div class="prompt-section__meta">
                        <span class="line-range">Lines {section.startLine}–{endLine}</span>
                        <div class="annotation-control" data-annotation-control>
                          <AnnotationIcon
                            as="button"
                            context="control"
                            kind="why"
                            aria-controls={explanationId}
                            aria-expanded="false"
                            aria-label={`Why ${section.title} exists in the ${definition.id} prompt`}
                            type="button"
                          />
                          <div class="annotation-popover" id={explanationId} role="tooltip">
                            <span>Why this exists</span>
                            <p>{section.annotation.explanation}</p>
                          </div>
                        </div>
                        {section.annotation.reference ? (
                          <div class="annotation-control reference-popover-control">
                            <AnnotationIcon
                              as="a"
                              class="reference-control reference-control--linked"
                              context="control"
                              href={section.annotation.reference.url}
                              kind="reference"
                              rel="noopener noreferrer"
                              target="_blank"
                              aria-describedby={referenceId}
                              aria-label={`Reference: ${section.annotation.reference.label}`}
                            />
                            <div class="annotation-popover" id={referenceId} role="tooltip">
                              <span>{section.annotation.reference.label}</span>
                              <p>{referenceExplanation}</p>
                            </div>
                          </div>
                        ) : null}
                      </div>
                    </header>

                    <ol class="prompt-lines" start={section.startLine} aria-label={`${section.title} prompt lines`}>
                      {section.lines.map((line) => (
                        <li><code>{line || "\u00a0"}</code></li>
                      ))}
                    </ol>
                  </article>
                );
              })}

              <div class="prompt-end">
                <a href="/" class="footer-mark" aria-label="Simplest SDD home">
                  <AnimatedWordmark variant="compact" decorative />
                </a>
                <button class="back-to-top" data-back-to-top type="button">
                  Back to top <span aria-hidden="true">↑</span>
                </button>
                <a href="/about">What is this? <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        </section>
      );
    })}

  </main>

  <script is:inline src="/scripts/how.js" defer></script>
</BaseLayout>

<style>
  :global(.how-body) {
    --page-width: 92rem;
    background:
      radial-gradient(circle at 70% 0, #1b1e1f 0, transparent 28rem),
      var(--bg);
  }

  main {
    width: min(100% - 2rem, var(--page-width));
    margin-inline: auto;
  }

  .prompt-end a {
    color: var(--muted);
    text-decoration: none;
  }

  .prompt-end a:hover {
    color: var(--ink);
  }

  .prompt-end a:focus-visible,
  .back-to-top:focus-visible,
  .prompt-actions a:focus-visible,
  .prompt-map a:focus-visible,
  .annotation-control button:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: .3rem;
  }

  .eyebrow {
    margin: 0 0 1.3rem;
    color: var(--muted);
    font: 700 .7rem/1 var(--font-sans);
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .how-hero h1,
  .guide-intro h2 {
    margin: 0;
    font-weight: 400;
    letter-spacing: -.05em;
  }

  .how-hero h1 {
    font-size: clamp(3.3rem, 7.4vw, 7rem);
    line-height: .9;
    text-wrap: pretty;
  }

  .how-hero {
    padding-top: 3rem;
  }

  .guide-intro h2 {
    line-height: .94;
  }

  .title-highlight {
    color: var(--vinaceous-cinnamon);
  }

  .title-highlight--orange {
    color: var(--orange);
  }

  .title-highlight--green {
    color: var(--dull-viridian-green);
  }

  .prompt-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 44rem;
    margin-top: 0;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .prompt-overview {
    margin-top: 3rem;
    margin-bottom: 8rem;
  }

  .prompt-tabs button {
    min-height: 4.25rem;
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .9rem 1rem;
    border: 0;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    font: 650 .82rem/1 var(--font-sans);
    text-align: left;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease;
  }

  .prompt-tabs button span {
    color: #606462;
    font: 600 .62rem/1 var(--font-mono);
  }

  .prompt-tabs button:hover {
    color: var(--ink);
  }

  .prompt-tabs button[aria-selected="true"] {
    background: var(--ink);
    color: var(--bg);

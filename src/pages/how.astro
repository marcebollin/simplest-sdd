---
import packageInfo from "../../package.json";
import schemaVersions from "../../schema/versions.json";
import AnnotationIcon from "../components/AnnotationIcon.astro";
import AnimatedWordmark from "../components/AnimatedWordmark.astro";
import CopyButton from "../components/CopyButton.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { prompts } from "../lib/prompts";
import { skillSources } from "../lib/skill-sources";

type Reference = {
  label: string;
  url: string;
  explanation?: string;
};

type Annotation = {
  explanation: string;
  tone: string;
  reference?: Reference;
};

const contractAnnotations: Record<string, Annotation> = {
  "The Workflow Contract": {
    explanation: "Installation and migration share one contract. It defines the local skill and the Markdown file where product decisions live.",
    tone: "indigo",
    reference: {
      label: "OpenAI: Rethinking skills and prompts for GPT-6 Astra",
      url: "https://developers.openai.com/blog/rethinking-skills-and-prompts-for-gpt-6-astra",
      explanation: "The article informed smaller instruction entrypoints, selective context loading, and removing workflow steps that repeat settled decisions."
    }
  },
  "`AGENTS.md` Section": {
    explanation: "The project instructions point to the local skill so a feature request, a bug report or a settled decision in chat can use the same guidance.",
    tone: "amber",
    reference: skillSources.potetoMode
  },
  "Audience and Communication": {
    explanation: "A client may want to hear what their customers will notice. An engineer reviewing the same change may want the failure case and the test result. The brief keeps each reader’s preferences in reach during ordinary conversation.",
    tone: "blue",
    reference: skillSources.theoLakebed
  },
  "Library Layout": {
    explanation: "An empty project needs only the skill and agent configuration. The first lasting decision creates DECISIONS.md. New areas are headings in that file.",
    tone: "teal"
  },
  "`SKILL.md`": {
    explanation: "The skill captures a settled rule during a conversation, finds existing decisions by ID, and checks shared consumers before changing product behavior.",
    tone: "violet",
    reference: skillSources.grillWithDocs
  },
  "Project Practice": {
    explanation: "This section belongs to the project. The agent puts testing commands and lasting workflow corrections here, or links an existing policy. An update preserves these refinements.",
    tone: "yellow"
  },
  "Claude Compatibility": {
    explanation: "Keeps the canonical instructions and skill usable from Claude without a second copy. The relative link makes both agent environments resolve the same workflow.",
    tone: "violet"
  }
};

const initAnnotations: Record<string, Annotation> = {
  ...contractAnnotations,
  "Start here": {
    explanation: "Names the job, pins the schema version, and tells the agent which repository it is changing before any decisions are made.",
    tone: "slate"
  },
  "Rules": {
    explanation: "Installation preserves project guidance, records confirmed business decisions and leaves feature work for a separate request.",
    tone: "rose"
  },
  "Inspect The Project And Its Testing Discipline": {
    explanation: "Project practice carries the repository’s testing policy, testing skill and commands, including TDD when configured.",
    tone: "blue"
  },
  "Ask Only What You Need": {
    explanation: "The agent asks when an unresolved choice would change the project guidance. With nothing material open, it can install immediately.",
    tone: "violet",
    reference: skillSources.grillMe
  },
  "Make `AGENTS.md` Canonical Without Losing Content": {
    explanation: "Keeps project facts and local constraints in one canonical file, whatever instruction files the project started with. Nothing is lost while consolidating.",
    tone: "amber"
  },
  "Validate": {
    explanation: "Checks that decisions, one-off requests and recurring feedback reach the right place, and that the workflow still uses the project’s testing policy.",
    tone: "lime"
  }
};

const updateAnnotations: Record<string, Annotation> = {
  ...contractAnnotations,
  "Start here": {
    explanation: "The CLI inspects the repository and prints the migration instructions. The coding agent applies them and verifies the converted files.",
    tone: "slate"
  },
  "Rules": {
    explanation: "Defines the scope of an update, including how to recognize a preserved decision file, an older HTML library or a newer schema.",
    tone: "rose"
  },
  "Inspect The Installation": {
    explanation: "Checks for existing audience guidance before filling a gap, even at the current version. A partial conversion reuses existing IDs and checks for leftover generated files.",
    tone: "blue"
  },
  "Replace The Workflow Instructions": {
    explanation: "Carries forward local practice and TDD while replacing generated instructions with the flat Markdown workflow.",
    tone: "violet"
  },
  "Convert The Library": {
    explanation: "The agent consolidates rules from older specs, the HTML map and area records into DECISIONS.md before retiring the original documents.",
    tone: "amber"
  },
  "Harvest The Business Decisions": {
    explanation: "Preserves the identity, scope and history of each distinct rule. Incoming links to HTML anchors become links to Markdown ID headings.",
    tone: "green",
    reference: {
      label: "OpenSpec",
      url: "https://github.com/Fission-AI/OpenSpec/blob/main/docs/concepts.md",
      explanation: "OpenSpec distinguishes current behavior from proposed changes. That distinction informed the statuses on decision records."
    }
  },
  "Drop The Technical Layer": {
    explanation: "The product promise survives the conversion. A partner’s CSV contract belongs in the library, while the choice of CSV writer belongs in code.",
    tone: "rose"
  },
  "Retire The Legacy Files": {
    explanation: "The agent discards obsolete generated reports, even in older framework backups. It verifies converted decisions and saves uncommitted source documents before retiring the old pages.",
    tone: "amber"
  },
  "Validate": {
    explanation: "Checks each legacy decision against the consolidated file and the report. It also verifies links, project policy, and recovery of uncommitted work before the marker advances.",
    tone: "lime"
  }
};

const removeAnnotations: Record<string, Annotation> = {
  "Start here": {
    explanation: "Deactivation stops the workflow from loading and preserves the recorded decisions.",
    tone: "slate"
  },
  "Rules": {
    explanation: "Separates generated configuration from project-owned documents. Deleting durable content requires confirmation of the exact files.",
    tone: "rose"
  },
  "Inspect Ownership": {
    explanation: "Classifies every relevant file before editing, so the agent can tell framework activation from decisions and history that belong to the project.",
    tone: "blue"
  },
  "Remove Agent Activation": {
    explanation: "Removes only the framework’s section and compatibility link. Unique testing guidance and local practices move to the project’s instructions first.",
    tone: "violet"
  },
  "Deactivate The Skill Without Losing User Data": {
    explanation: "Deactivates the skill while preserving DECISIONS.md, project-owned documents and historical backups.",
    tone: "amber"
  },
  "Validate": {
    explanation: "Confirms the framework is inactive and the project’s knowledge survived. Remaining references are reported instead of silently deleted.",
    tone: "lime"
  }
};

function slugify(value: string) {
  return value
    .toLowerCase()
    .replace(/`/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

type PromptSection = {
  title: string;
  id: string;
  level: number;
  startLine: number;
  lines: string[];
  annotation: Annotation;
};

function parsePrompt(promptId: string, rawPrompt: string, annotations: Record<string, Annotation>) {
  const source = rawPrompt.replace(/\r\n/g, "\n").replace(/\n$/, "");
  const lines = source.split("\n");
  const sections: PromptSection[] = [];
  let inFence = false;
  let current: PromptSection = {
    title: "Start here",
    id: `${promptId}-start-here`,
    level: 1,
    startLine: 1,
    lines: [],
    annotation: annotations["Start here"]
  };

  for (const [index, line] of lines.entries()) {
    const fenceLine = line.trimStart().startsWith("```");
    const heading = !inFence ? line.match(/^(##|###)\s+(.+)$/) : null;

    if (heading && current.lines.length > 0) {
      sections.push(current);
      const title = heading[2];
      current = {
        title,
        id: `${promptId}-${slugify(title)}`,
        level: heading[1].length,
        startLine: index + 1,
        lines: [],
        annotation: annotations[title] ?? {
          explanation: "This section is part of the workflow. Refine this explanation as the framework evolves.",
          tone: "slate"
        }
      };
    }

    current.lines.push(line);
    if (fenceLine) inFence = !inFence;
  }

  sections.push(current);
  return {
    source,
    lines,
    sections,
    wordCount: source.trim().split(/\s+/).length
  };
}

const promptDefinitions = [
  {
    id: "init",
    tabLabel: "Install",
    actionLabel: "installation",
    summary: "Installs the skill with the project’s testing discipline and guidance on how to address each reader. A confirmed rule creates the first decision file.",
    instruction: "Run npx simplest-sdd@latest init and follow the instructions",
    rawUrl: "/init-prompt.txt",
    githubUrl: "https://github.com/marcebollin/simplest-sdd/blob/main/prompts/init.md",
    prompt: parsePrompt("init", prompts.init, initAnnotations)
  },
  {
    id: "update",
    tabLabel: "Update",
    actionLabel: "migration",
    summary: "Adds missing communication guidance and keeps established preferences. Older Markdown and HTML libraries become one DECISIONS.md file after the agent checks links and preserves originals that need recovery.",
    instruction: "Run npx simplest-sdd@latest update and follow the instructions",
    rawUrl: "/update-prompt.txt",
    githubUrl: "https://github.com/marcebollin/simplest-sdd/blob/main/prompts/update.md",
    prompt: parsePrompt("update", prompts.update, updateAnnotations)
  },
  {
    id: "remove",
    tabLabel: "Remove",
    actionLabel: "removal",
    summary: "Deactivates the workflow and preserves the decision file, project practices and older project-owned documents.",
    instruction: "Run npx simplest-sdd@latest remove and follow the instructions",
    rawUrl: "/remove-prompt.txt",
    githubUrl: "https://github.com/marcebollin/simplest-sdd/blob/main/prompts/remove.md",
    prompt: parsePrompt("remove", prompts.remove, removeAnnotations)
  }
];

const currentRelease = schemaVersions.versions.find(
  (release) => release.version === schemaVersions.currentSchemaVersion
);
---

<BaseLayout
  title="How Simplest SDD works"
  description="Read the instructions that teach an agent to keep product decisions, learn project practices and migrate older Simplest SDD libraries."
  canonicalPath="/how/"
  bodyClass="how-body"
>
  <SiteHeader current="how" />

  <main>
    <section class="how-hero" aria-labelledby="how-title">
      <h1 id="how-title">
        Inside the <span class="title-highlight title-highlight--orange">Simplest SDD</span> skill
      </h1>

      <div class="version-strip" aria-label="Documented Simplest SDD version">
        <div>
          <span>CLI package</span>
          <strong>v{packageInfo.version}</strong>
        </div>
        <div>
          <span>Schema</span>
          <strong>v{schemaVersions.currentSchemaVersion}</strong>
        </div>
        <div>
          <span>Schema date</span>
          <strong>{currentRelease?.date ?? "Current"}</strong>
        </div>
        <p>
          Read the instructions your coding agent follows to install, update or remove the skill.
          The CLI prints these same prompts and adds your project’s inventory for updates and removal.
        </p>
      </div>
    </section>

    <section class="prompt-overview" aria-label="Prompt overview">
      <div class="prompt-tabs" role="tablist" aria-label="Choose a Simplest SDD prompt">
        {promptDefinitions.map((definition, index) => (
          <button
            aria-controls={`${definition.id}-prompt-panel`}
            aria-selected={index === 0 ? "true" : "false"}
            data-prompt-tab={definition.id}
            id={`${definition.id}-prompt-tab`}
            role="tab"
            tabindex={index === 0 ? 0 : -1}
            type="button"
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            {definition.tabLabel}
          </button>
        ))}
      </div>

      {promptDefinitions.map((definition, definitionIndex) => {
        const { prompt } = definition;

        return (
          <div data-prompt-summary={definition.id} hidden={definitionIndex !== 0}>
            <div class="hero-bottom">
              <p>
                <strong>{definition.tabLabel}:</strong> {definition.summary} Every color marks a different
                responsibility. Hover, focus, or click the <strong>i</strong> to see why a section exists.
              </p>
              <div class="prompt-actions">
                <a href={definition.rawUrl}>View raw prompt</a>
                <a href={definition.githubUrl} rel="noopener noreferrer" target="_blank">
                  GitHub source <span aria-hidden="true">↗</span>
                </a>
                <CopyButton
                  text={definition.instruction}
                  label={`Copy the ${definition.id} CLI instruction`}
                  className="copy-full-prompt"
                  displayText="Copy prompt"
                  confirmedText="Copy prompt"
                />
              </div>
            </div>
          </div>
        );
      })}
    </section>

    {promptDefinitions.map((definition, definitionIndex) => {
      const { prompt } = definition;
      const guideTitleId = `${definition.id}-guide-title`;

      return (
        <section
          aria-labelledby={`${definition.id}-prompt-tab`}
          data-prompt-panel={definition.id}
          hidden={definitionIndex !== 0}
          id={`${definition.id}-prompt-panel`}
          role="tabpanel"
          tabindex="0"
        >
          <section class="guide-intro" aria-labelledby={guideTitleId}>
            <div class="guide-intro__content">
              <div class="guide-intro__heading">
                <h2 id={guideTitleId}>
                  The whole <span class="title-highlight title-highlight--orange">prompt</span>, with the{" "}
                  <span class="title-highlight title-highlight--orange">why</span> attached.
                </h2>
                <div class="legend" aria-label="Annotation legend">
                  <span><AnnotationIcon kind="why" /> Why this part exists</span>
                  <span><AnnotationIcon kind="reference" /> Inspiration source</span>
                </div>
              </div>
              <div
                class="prompt-facts"
                aria-label={`${definition.tabLabel} prompt facts`}
                data-prompt-summary={definition.id}
                hidden={definitionIndex !== 0}
              >
                <span>{prompt.lines.length} lines</span>
                <span>{prompt.wordCount.toLocaleString("en-US")} words</span>
                <span>{prompt.sections.length} explained parts</span>
              </div>
            </div>
          </section>

          <div class="prompt-layout">
            <aside class="prompt-map">
              <ol>
                {prompt.sections.map((section, index) => (
                  <li class:list={[section.level === 3 && "prompt-map__subsection"]}>
                    <a href={`#${section.id}`}>
                      <span>{String(index + 1).padStart(2, "0")}</span>
                      {section.title}
                    </a>
                  </li>
                ))}
              </ol>
            </aside>

            <div class="prompt-sections">
              {prompt.sections.map((section, index) => {
                const endLine = section.startLine + section.lines.length - 1;
                const explanationId = `${section.id}-explanation`;
                const referenceId = `${section.id}-reference`;
                const referenceExplanation = section.annotation.reference?.explanation
                  ?? "This source directly informed the design of this part of the workflow.";

                return (
                  <article
                    class:list={["prompt-section", `prompt-section--accent-${(index % 3) + 1}`]}
                    id={section.id}
                  >
                    <header class="prompt-section__header">
                      <div>
                        <span class="prompt-section__index">{String(index + 1).padStart(2, "0")}</span>
                        <h3>{section.title}</h3>
                        <CopyButton
                          sectionId={section.id}
                          label={`Copy link to ${section.title}`}
                          className="section-copy-button"
                        />
                      </div>
                      <div class="prompt-section__meta">
                        <span class="line-range">Lines {section.startLine}–{endLine}</span>
                        <div class="annotation-control" data-annotation-control>
                          <AnnotationIcon
                            as="button"
                            context="control"
                            kind="why"
                            aria-controls={explanationId}
                            aria-expanded="false"
                            aria-label={`Why ${section.title} exists in the ${definition.id} prompt`}
                            type="button"
                          />
                          <div class="annotation-popover" id={explanationId} role="tooltip">
                            <span>Why this exists</span>
                            <p>{section.annotation.explanation}</p>
                          </div>
                        </div>
                        {section.annotation.reference ? (
                          <div class="annotation-control reference-popover-control">
                            <AnnotationIcon
                              as="a"
                              class="reference-control reference-control--linked"
                              context="control"
                              href={section.annotation.reference.url}
                              kind="reference"
                              rel="noopener noreferrer"
                              target="_blank"
                              aria-describedby={referenceId}
                              aria-label={`Reference: ${section.annotation.reference.label}`}
                            />
                            <div class="annotation-popover" id={referenceId} role="tooltip">
                              <span>{section.annotation.reference.label}</span>
                              <p>{referenceExplanation}</p>
                            </div>
                          </div>
                        ) : null}
                      </div>
                    </header>

                    <ol class="prompt-lines" start={section.startLine} aria-label={`${section.title} prompt lines`}>
                      {section.lines.map((line) => (
                        <li><code>{line || "\u00a0"}</code></li>
                      ))}
                    </ol>
                  </article>
                );
              })}

              <div class="prompt-end">
                <a href="/" class="footer-mark" aria-label="Simplest SDD home">
                  <AnimatedWordmark variant="compact" decorative />
                </a>
                <button class="back-to-top" data-back-to-top type="button">
                  Back to top <span aria-hidden="true">↑</span>
                </button>
                <a href="/about">What is this? <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </div>
        </section>
      );
    })}

  </main>

  <script is:inline src="/scripts/how.js" defer></script>
</BaseLayout>

<style>
  :global(.how-body) {
    --page-width: 92rem;
    background:
      radial-gradient(circle at 70% 0, #1b1e1f 0, transparent 28rem),
      var(--bg);
  }

  main {
    width: min(100% - 2rem, var(--page-width));
    margin-inline: auto;
  }

  .prompt-end a {
    color: var(--muted);
    text-decoration: none;
  }

  .prompt-end a:hover {
    color: var(--ink);
  }

  .prompt-end a:focus-visible,
  .back-to-top:focus-visible,
  .prompt-actions a:focus-visible,
  .prompt-map a:focus-visible,
  .annotation-control button:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: .3rem;
  }

  .eyebrow {
    margin: 0 0 1.3rem;
    color: var(--muted);
    font: 700 .7rem/1 var(--font-sans);
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .how-hero h1,
  .guide-intro h2 {
    margin: 0;
    font-weight: 400;
    letter-spacing: -.05em;
  }

  .how-hero h1 {
    font-size: clamp(3.3rem, 7.4vw, 7rem);
    line-height: .9;
    text-wrap: pretty;
  }

  .how-hero {
    padding-top: 3rem;
  }

  .guide-intro h2 {
    line-height: .94;
  }

  .title-highlight {
    color: var(--vinaceous-cinnamon);
  }

  .title-highlight--orange {
    color: var(--orange);
  }

  .title-highlight--green {
    color: var(--dull-viridian-green);
  }

  .prompt-tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 44rem;
    margin-top: 0;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  .prompt-overview {
    margin-top: 3rem;
    margin-bottom: 8rem;
  }

  .prompt-tabs button {
    min-height: 4.25rem;
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .9rem 1rem;
    border: 0;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    background: transparent;
    color: var(--muted);
    font: 650 .82rem/1 var(--font-sans);
    text-align: left;
    cursor: pointer;
    transition: background 160ms ease, color 160ms ease;
  }

  .prompt-tabs button span {
    color: #606462;
    font: 600 .62rem/1 var(--font-mono);
  }

  .prompt-tabs button:hover {
    color: var(--ink);
  }

  .prompt-tabs button[aria-selected="true"] {
    background: var(--ink);
    color: var(--bg);
  }

  .prompt-tabs button[aria-selected="true"] span {
    color: #555957;
  }

  .prompt-tabs button:focus-visible {
    position: relative;
    z-index: 1;
    outline: 1px solid var(--ink);
    outline-offset: .25rem;
  }

  .version-strip {
    display: grid;
    grid-template-columns: auto auto auto minmax(0, 1fr);
    align-items: stretch;
    gap: 0;
    margin-top: 3rem;
    border: 1px solid var(--line);
    background: rgba(10, 11, 12, .62);
  }

  .version-strip > div {
    min-width: 9rem;
    display: grid;
    gap: .4rem;
    align-content: center;
    padding: 1rem 1.2rem;
    border-right: 1px solid var(--line);
  }

  .version-strip span {
    color: var(--muted);
    font: 600 .62rem/1 var(--font-sans);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .version-strip strong {
    color: var(--ink-soft);
    font: 600 .85rem/1 var(--font-mono);
  }

  .version-strip p {
    align-self: center;
    margin: 0;
    padding: 1rem 1.2rem;
    color: var(--muted);
    font: 400 .78rem/1.55 var(--font-sans);
    text-wrap: pretty;
  }

  .hero-bottom {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 2rem;
  }

  .hero-bottom > p {
    max-width: 48rem;
    margin: 0;
    color: var(--ink-soft);
    font: 400 clamp(1rem, 1.5vw, 1.2rem)/1.7 var(--font-sans);
  }

  .prompt-actions {
    width: min(100%, 27.75rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: .75rem;
  }

  .prompt-actions > a,
  :global(.copy-full-prompt.command-button) {
    width: 100%;
    min-height: 2.8rem;
    display: grid;
    grid-auto-flow: column;
    align-items: center;
    justify-content: center;
    gap: .4rem;
    padding: .75rem .9rem;
    margin-left: 0;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink-soft);
    font: 650 .75rem/1 var(--font-sans);
    text-decoration: none;
  }

  .prompt-actions > a:nth-child(2) {
    gap: .4rem;
  }

  :global(.copy-full-prompt:hover),
  :global(.copy-full-prompt.command-button--confirmed) {
    color: var(--ink);
  }

  :global(.copy-full-prompt .command-labels) {
    position: relative;
    display: inline-grid;
    place-items: center;
  }

  :global(.copy-full-prompt .command-label) {
    grid-area: 1 / 1;
    white-space: nowrap;
    transition:
      opacity 180ms ease,
      filter 180ms ease,
      transform 240ms cubic-bezier(.22, .8, .36, 1);
  }

  :global(.copy-full-prompt .command-label--idle) {
    position: relative;
  }

  :global(.copy-full-prompt .command-label--confirmed) {
    opacity: 0;
    filter: blur(.18rem);
    transform: translateX(-.2rem);
  }

  :global(.copy-full-prompt.command-button--confirmed .command-label--idle) {
    opacity: 0;
    filter: blur(.18rem);
    transform: translateX(.2rem);
  }

  :global(.copy-full-prompt.command-button--confirmed .command-label--confirmed) {
    opacity: 1;
    filter: blur(0);
    transform: translateX(0);
  }

  .prompt-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 3rem;
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
  }

  [data-prompt-panel][hidden],
  [data-prompt-summary][hidden] {
    display: none;
  }

  .prompt-facts span {
    padding: 1rem;
    border-right: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
    color: var(--muted);
    font: 600 .74rem/1 var(--font-sans);
    text-align: center;
  }

  .guide-intro__heading {
    display: flex;
    align-items: center;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .guide-intro h2 {
    width: 100%;

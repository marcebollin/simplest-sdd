{
  "name": "simplest-sdd",
  "version": "0.12.0",
  "description": "A discovery-first workflow that reuses existing specs automatically and asks before creating new ones.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcebollin/simplest-sdd.git"
  },
  "homepage": "https://github.com/marcebollin/simplest-sdd#readme",
  "bugs": {
    "url": "https://github.com/marcebollin/simplest-sdd/issues"
  },
  "type": "module",
  "bin": {
    "simplest-sdd": "bin/simplest-sdd.mjs"
  },
  "files": [
    "bin",
    "lib",
    "docs",
    "examples",
    "prompts",
    "schema",
    "PROMPT.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "astro dev --port 3010",
    "build": "astro build && node scripts/audit-production-html.mjs",
    "preview": "astro preview --port 3010",
    "deploy": "pnpm run build && wrangler deploy && pnpm run verify:deployment",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test": "node --test"
  },
  "keywords": [
    "agents",
    "claude",
    "codex",
    "orchestration",
    "analytics",
    "spec-driven-development",
    "sdd"
  ],
  "author": "Marcelo Leon",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "astro": "^7.1.3",
    "grabim": "link:/Users/marcelo/Dev/side-projects/grabim/packages/grabim",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wrangler": "^4.112.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
